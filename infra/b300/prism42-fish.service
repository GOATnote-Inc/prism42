# Systemd unit for Fish Speech S2-Pro TTS (Prism42 B300 deployment).
#
# Source of truth lives here; `/etc/systemd/system/prism42-fish.service`
# on the pod must match. Update via:
#   scp infra/b300/prism42-fish.service prism-mla-b300-h4h5:/tmp/
#   ssh prism-mla-b300-h4h5 "sudo cp /tmp/prism42-fish.service \
#     /etc/systemd/system/prism42-fish.service && \
#     sudo systemctl daemon-reload && \
#     sudo systemctl restart prism42-fish"
#
# Why --compile (added 2026-04-25): the Glasswing-aligned bottleneck
# triangulation (findings/b300_bench/profiler/PROFILE-20260424-local-
# triangulation/bottleneck-card.json) showed Fish RTF 2.04 — Fish
# generates audio at half playback rate, causing WebRTC underrun.
# Investigation revealed fish-speech ALREADY wires `torch.compile` on
# `decode_one_token` at `fish_speech/models/text2semantic/inference.py:
# 383-390`, but only when `args.compile=True` is passed to api_server.py.
# Adding `--compile` to the ExecStart engages it. Expected RTF impact:
# 1.5-3× speedup typical for autoregressive transformer decode loops.
#
# Compile cold-start adds ~30-60s on first synth call; subsequent calls
# benefit. Restart sequence intentionally warms via the synthetic caller
# before declaring the deploy successful.
#
# Rollback: drop --compile, daemon-reload, restart. Other env vars
# (PYTORCH_JIT=0, PYTORCH_TENSOREXPR_FALLBACK=2, TRITON_CODEGEN_ARCH=100)
# preserved as-is — they predate this change and may be load-bearing
# for some pre-existing failure mode the operators wanted to suppress.
# Future iteration: experiment with removing them if --compile lands clean.

[Unit]
Description=Fish Speech S2-Pro TTS (Prism42)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shadeform
WorkingDirectory=/opt/prism42/infra/b300/services/fish-speech
Environment=PYTORCH_JIT=0
Environment=PYTORCH_TENSOREXPR_FALLBACK=2
Environment=TORCH_CUDA_ARCH_LIST=10.0;10.3
Environment=TRITON_CODEGEN_ARCH=100
ExecStart=/opt/prism42/infra/b300/services/fish-speech/.venv/bin/python src/tools/api_server.py --mode tts --listen 127.0.0.1:9200 --llama-checkpoint-path checkpoints/s2-pro --decoder-checkpoint-path checkpoints/s2-pro/codec.pth --device cuda --half --compile
Restart=always
RestartSec=4
StandardOutput=append:/tmp/prism42-logs/fish.log
StandardError=append:/tmp/prism42-logs/fish.log
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

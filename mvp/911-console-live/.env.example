# mvp/911-console-live — local env template. Copy to .env.local for
# `npm run dev`. Production reads these from Vercel project env.
#
# Never commit .env.local. Never paste keys into chat.

# -- Anthropic (voice-facing agents via Managed Agents) --------------------
# Required. Model ID `claude-opus-4-7`. Workspace-scoped; must be the same
# workspace the 14 PSAP agents are registered in (see agents/psap-manifest.yaml).
ANTHROPIC_API_KEY=

# Optional. Override the coordinator agent ID to use. Defaults to the
# psap-team-coordinator entry in agents/psap-manifest.yaml.
PRISM42_COORDINATOR_AGENT_ID=

# -- OpenAI (cross-vendor rubric grader — primary hot path) -----------------
# Required for rubric grading. GPT-5.5 primary / GPT-5.4 fallback per
# agents/psap-rubric-live.yaml. Runs OUTSIDE Managed Agents — runtime
# chat-completion call — for cross-vendor independence from the voice agent.
OPENAI_API_KEY=

# -- ElevenLabs (voice I/O) -------------------------------------------------
# Optional server-side key; primary use is client-side by ElevenLabs
# Conversational AI platform calling our /prism42/api/chat/completions.
# Needed here only if we add server-initiated TTS (Phase 2b).
ELEVENLABS_API_KEY=

# REQUIRED for the embedded <elevenlabs-convai> widget to render on
# /prism42 (legacy ElevenLabs A/B baseline). Copy the agent id from
# your ConvAI dashboard (Agent → Settings → Agent ID). The
# `NEXT_PUBLIC_` prefix is mandatory — this value ships to the browser.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# -- LiveKit (Phase 3a — primary voice runtime, replaces ElevenLabs) --
# Self-hosted LiveKit server on the B300 pod (per
# docs/livekit-architecture.md §6). The browser uses
# NEXT_PUBLIC_LIVEKIT_URL to dial; the Vercel token-mint route uses
# the secret key+secret pair to mint short-lived JWTs.
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.thegoatnote.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# -- STT / TTS (consumed by the Python agent worker, NOT the Next.js app) --
# These belong in the .env on the B300 pod, not in Vercel env. Listed
# here so /Users/kiteboard/prism42/.env can carry them once and
# scp them to the pod via setup.sh.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# -- GoDaddy DNS (used once at pod provisioning by setup-dns.sh) --
# Get from https://developer.godaddy.com/keys (Production keys).
GODADDY_API_KEY=
GODADDY_API_SECRET=

# -- B300 pod ----------------------------------------------------
# REDIS_URL is set automatically by setup.sh on the pod (loopback);
# left here for local-dev fallback if you want to run the worker
# against a local docker redis.
REDIS_URL=
PRISM42_LOG_DIR=/var/log/prism42

# -- Session + observability ------------------------------------------------
# Optional. When set, session records are mirrored to this Upstash Redis
# instance (rest API). Phase 2b — ignored if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -- Deploy posture ---------------------------------------------------------
# Optional. Set to "1" to suppress the banner warning on /prism42 that the
# session is synthetic-fixture mode. Never set in production.
PRISM42_SUPPRESS_SIMULATION_BANNER=

# NOTE: PRISM42_BASE_PATH is intentionally not used. The /prism42 path
# prefix is baked into the app's file tree (app/prism42/*) because
# Vercel Microfrontends does not support Next.js basePath. See
# next.config.ts for the full rationale.

# mvp/911-console-live — local env template. Copy to .env.local for
# `npm run dev`. Production reads these from Vercel project env.
#
# Never commit .env.local. Never paste keys into chat.

# -- Anthropic (voice-facing agents via Managed Agents) --------------------
# Required. Model ID `claude-opus-4-7`. Workspace-scoped; must be the same
# workspace the 14 PSAP agents are registered in (see agents/psap-manifest.yaml).
ANTHROPIC_API_KEY=

# Optional. Override the coordinator agent ID to use. Defaults to the
# psap-team-coordinator entry in agents/psap-manifest.yaml.
PRISM42_COORDINATOR_AGENT_ID=

# -- OpenAI (cross-vendor rubric grader — primary hot path) -----------------
# Required for rubric grading. GPT-5.5 primary / GPT-5.4 fallback per
# agents/psap-rubric-live.yaml. Runs OUTSIDE Managed Agents — runtime
# chat-completion call — for cross-vendor independence from the voice agent.
OPENAI_API_KEY=

# -- ElevenLabs (voice I/O) -------------------------------------------------
# Optional for server-side operations; primary use is client-side by
# ElevenLabs Conversational AI platform calling our /api/chat/completions.
# Needed here only if we add server-initiated TTS (Phase 2b).
ELEVENLABS_API_KEY=

# -- Session + observability ------------------------------------------------
# Optional. When set, session records are mirrored to this Upstash Redis
# instance (rest API). Phase 2b — ignored if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -- Deploy posture ---------------------------------------------------------
# Optional. Set to "1" to suppress the banner warning on /prism42 that the
# session is synthetic-fixture mode. Never set in production.
PRISM42_SUPPRESS_SIMULATION_BANNER=

# Optional. Override the public base path. Empty string = root-mounted.
PRISM42_BASE_PATH=/prism42

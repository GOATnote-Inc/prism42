{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "next build",
  "devCommand": "next dev --port 3042",
  "framework": "nextjs",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "functions": {
    "app/prism42/api/chat/completions/route.ts": {
      "maxDuration": 60
    },
    "app/prism42/api/rubric/grade/route.ts": {
      "maxDuration": 30
    },
    "app/prism42/api/session/[id]/stream/route.ts": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://prism42-console.vercel.app/prism42-v3",
      "permanent": false,
      "has": [
        { "type": "host", "value": "prism42-app.thegoatnote.com" }
      ]
    },
    {
      "source": "/4uwhat",
      "destination": "/4UWHAt",
      "permanent": false
    },
    {
      "source": "/4uwhat/:path*",
      "destination": "/4UWHAt/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/4UWHAt",
      "destination": "https://medomni.vercel.app/4UWHAt"
    },
    {
      "source": "/4UWHAt/:path*",
      "destination": "https://medomni.vercel.app/4UWHAt/:path*"
    }
  ]
}

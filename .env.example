# Prism — API key template. Copy to .env and fill in real values.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored (see .gitignore). Never commit real keys.
# Never paste the contents of .env into chat or issue trackers.
#
# The Makefile auto-sources .env on every target via `include .env`.

# -- LLM providers --------------------------------------------------------
# Anthropic — the brain. Opus 4.7 Managed Agents.
# Get one at: console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — optional judge / cross-check model.
# Get one at: platform.openai.com/api-keys
OPENAI_API_KEY=

# -- Compute rails --------------------------------------------------------
# RunPod — PRIMARY rail. H100 SXM + H200 SXM self-serve.
# Get one at: console.runpod.io/user/settings (Read/Write scope)
RUNPOD_API_KEY=

# Lambda Labs — BACKUP rail. H100 PCIe.
# Get one at: cloud.lambdalabs.com/api-keys
LAMBDA_API_KEY=

# NVIDIA NGC — for pulling NGC container images (Neuron, CUDA toolchains)
# and NIM inference endpoints. Get one at:
#   NGC key:      org.ngc.nvidia.com/setup/api-key
#   NIM/Catalog:  build.nvidia.com (separate key; use whichever you need)
NVIDIA_API_KEY=

# -- Model / dataset hosting ---------------------------------------------
# Hugging Face — model weights, datasets, optional Spaces deploys.
# Get one at: huggingface.co/settings/tokens  (read or write scope)
HF_TOKEN=

# -- Demo / media --------------------------------------------------------
# ElevenLabs — for demo-video voiceover (T6 gate).
# Get one at: elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

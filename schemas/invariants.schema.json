{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prism.goatnote.ai/schemas/invariants.schema.json",
  "title": "Prism Invariants",
  "description": "Defender output: a list of invariants claimed to hold on the target, each tagged with evidence and confidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "round", "invariants"],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,}-[A-Z]+-[A-Z0-9]{3,}$",
      "description": "Must equal case.json/case_id."
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "description": "Adversarial iteration index; 0 on first pass."
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "statement", "source_lines", "confidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^INV-\\d{3}$",
            "description": "Invariant identifier, zero-padded three-digit."
          },
          "class": {
            "type": "string",
            "enum": ["numerical", "memory", "concurrency", "precision", "other"],
            "description": "Taxonomic class constraining attacker strategy."
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable invariant statement."
          },
          "source_lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer"
            },
            "description": "Line numbers in target_path that ground the claim."
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Defender's self-reported confidence in [0,1]."
          }
        }
      }
    }
  }
}
